{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "WeatherForecast": {
      "EnabledFor": [
          {
            "name": "Microsoft.Targeting",
            "parameters": {
              "Audience": {
                "Users": [
                  "username1",
                  "username2"
                ],
                "Groups": [
                  {
                    "Name": "BetaUsers",
                    "RolloutPercentage": 100
                  },
                  {
                    "Name": "Internal",
                    "RolloutPercentage": 75
                  }
                ],
                "DefaultRolloutPercentage": 100
              }
            }
          }
        
      ]
    }
  }
}
